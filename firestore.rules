rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && me().active == true; }
    function isAdmin() { return active() && me().role == 'admin'; }
    function can(p) { return active() && (me().role == 'admin' || me().perms[p] == true); }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
    match /tts/{id} {
      allow read: if can('open');
      allow create, update: if can('add');
      allow delete: if can('reset');
    }
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if can('editLink');
    }
    match /sessions/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read, delete: if isAdmin();
    }
    match /logs/{id} {
      allow create: if active() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
    }
  }
}
